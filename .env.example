# Dhakshu Bakes — Environment Configuration Template
# Copy this file to .env for local overrides (never commit .env)

# Backend Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (Production / PostgreSQL)
DATABASE_URL=jdbc:postgresql://localhost:5432/dhakshubakes_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_secure_db_password

# JWT Security Configuration
# Generate a strong 256-bit secret key (min 32 characters)
JWT_SECRET=YourSuperSecretKeyForDhakshuBakesJwtSigningMustBeAtLeast32BytesLong!
JWT_EXPIRATION_MS=86400000

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID=rzp_test_YourRazorpayKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpayKeySecretHere

# Cloudinary Image Storage Credentials (Optional)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SMTP Email Configuration (Optional)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=noreply@dhakshubakes.com
MAIL_PASSWORD=your_app_password

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_RAZORPAY_KEY_ID=rzp_test_YourRazorpayKeyIdHere
